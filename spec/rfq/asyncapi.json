          },
          "evm_chain_id": {
            "type": "integer",
            "format": "uint64",
            "description": "EVM chain ID embedded in the EIP-712 domain at signing time. Zero for v1 (raw JSON) orders."
          },
          "taker_nonce_time_window_ms": {
            "type": "integer",
            "format": "uint64",
            "description": "Replay protection nonce time window in milliseconds"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "All error messages accumulated across execution attempts (most recent last)"
            },
            "description": "All error messages accumulated across execution attempts (most recent last)"
          }
        }
      },
      "CreateRFQRequestType": {
